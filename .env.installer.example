# One compact JSON object. The recommended blob_path values refer to files in a
# private Vercel Blob store connected to this project. The API returns a ten-minute
# signed URL only after license authorization. A public HTTPS `url` can be used
# instead of `blob_path`, but never set both. Generate checksums and sizes with
# scripts/catalog-entry.mjs after building the signed MSI and notarized PKG.
EC_INSTALLER_CATALOG_JSON={"quantum-dither-synth":{"display_name":"Quantum Dither Synth","version":"1.3.0","license_profile":"qds-v1","artifacts":{"windows-x64":{"blob_path":"releases/QuantumDitherSynth-1.3.0-Windows.msi","file_name":"QuantumDitherSynth-1.3.0-Windows.msi","install_type":"msi","sha256":"REPLACE_WITH_64_HEX_CHARACTERS","size_bytes":123456},"macos-universal":{"blob_path":"releases/QuantumDitherSynth-1.3.0-macOS.pkg","file_name":"QuantumDitherSynth-1.3.0-macOS.pkg","install_type":"pkg","sha256":"REPLACE_WITH_64_HEX_CHARACTERS","size_bytes":123456}}}}
